<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #050505;
    color: white;
}

a {
    text-decoration: none;
    color: inherit;
}

/* NAVBAR */

nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 7%;

    background: rgba(5,5,5,0.9);
    backdrop-filter: blur(12px);

    border-bottom: 1px solid #222;
}

.logo {
    font-size: 25px;
    font-weight: 900;
}

.logo span {
    color: #e50914;
}

.nav-links {
    display: flex;
    gap: 25px;
    list-style: none;
}

.nav-links a {
    color: #ccc;
    font-weight: bold;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #e50914;
}

.discord-btn {
    background: #e50914;
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: bold;
}

.discord-btn:hover {
    background: #ff202c;
}

/* HERO */

.hero {
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 120px 20px 80px;

    background:
        radial-gradient(
            circle at center,
            rgba(229,9,20,0.18),
            transparent 45%
        );
}

.hero-content {
    max-width: 850px;
}

.badge {
    display: inline-block;

    padding: 8px 15px;

    border: 1px solid rgba(229,9,20,0.4);
    border-radius: 30px;

    color: #ff4a52;

    margin-bottom: 20px;

    font-weight: bold;
}

.hero h1 {
    font-size: clamp(50px, 9vw, 90px);
    line-height: 1;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #e50914;
}

.hero p {
    color: #aaa;
    font-size: 18px;
    line-height: 1.7;
}

.hero-buttons {
    margin-top: 30px;

    display: flex;
    justify-content: center;
    gap: 15px;

    flex-wrap: wrap;
}

.button {
    padding: 14px 25px;
    border-radius: 9px;
    font-weight: bold;

    transition: 0.3s;
}

.primary {
    background: #e50914;
}

.primary:hover {
    background: #ff202c;
    transform: translateY(-3px);
}

.secondary {
    border: 1px solid #333;
    background: #111;
}

.secondary:hover {
    background: #1b1b1b;
    transform: translateY(-3px);
}

/* SECTIONS */

section {
    max-width: 1150px;
    margin: auto;
    padding: 90px 20px;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title small {
    color: #e50914;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-title h2 {
    font-size: 40px;
    margin-top: 8px;
}

.section-title p {
    color: #999;
    margin-top: 10px;
}

/* CARDS */

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: #111;
    border: 1px solid #222;

    border-radius: 15px;

    padding: 28px;

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);

    border-color: rgba(229,9,20,0.6);

    box-shadow:
        0 15px 40px rgba(0,0,0,0.4);
}

.icon {
    font-size: 35px;
    margin-bottom: 15px;
}

.card h3 {
    margin-bottom: 10px;
    font-size: 21px;
}

.card p {
    color: #999;
    font-size: 15px;
    line-height: 1.6;
}

.card ul {
    list-style: none;
    margin-top: 18px;
}

.card li {
    color: #ddd;
    margin: 9px 0;
    font-size: 14px;
}

.card li::before {
    content: "✓";
    color: #e50914;
    font-weight: bold;
    margin-right: 8px;
}

/* PRICES */

.price {
    color: #e50914;
    font-size: 32px;
    font-weight: 900;

    margin: 15px 0;
}

.price span {
    color: #888;
    font-size: 14px;
    font-weight: normal;
}

/* FEATURED */

.featured {
    border-color: #e50914;

    box-shadow:
        0 0 30px rgba(229,9,20,0.12);
}

.popular {
    display: inline-block;

    background: #e50914;

    padding: 5px 10px;

    border-radius: 20px;

    font-size: 11px;
    font-weight: bold;

    margin-bottom: 10px;
}

/* TICKET */

.ticket {
    text-align: center;

    background:
        linear-gradient(
            135deg,
            rgba(229,9,20,0.15),
            rgba(229,9,20,0.02)
        );

    border: 1px solid rgba(229,9,20,0.3);

    border-radius: 20px;

    padding: 55px 25px;
}

.ticket h2 {
    font-size: 38px;
    margin-bottom: 15px;
}

.ticket p {
    color: #aaa;

    max-width: 650px;

    margin: 0 auto 25px;
}

/* ABOUT */

.about {
    text-align: center;
    max-width: 750px;
    margin: auto;
}

.about p {
    color: #aaa;
    line-height: 1.8;
}

/* FOOTER */

footer {
    border-top: 1px solid #222;

    padding: 40px 20px;

    background: #030303;
}

.footer {
    max-width: 1100px;
    margin: auto;

    display: flex;

    justify-content: space-between;

    gap: 20px;

    flex-wrap: wrap;
}

.footer h3 span {
    color: #e50914;
}

.footer p {
    color: #777;
    margin-top: 8px;
}

.footer-links {
    display: flex;
    gap: 20px;
}

.footer-links a {
    color: #999;
}

.footer-links a:hover {
    color: #e50914;
}

.copyright {
    max-width: 1100px;

    margin: 25px auto 0;

    padding-top: 20px;

    border-top: 1px solid #1b1b1b;

    color: #555;

    font-size: 13px;
}

/* MOBILE */

@media(max-width:800px) {

    .nav-links {
        display: none;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 55px;
    }

    .section-title h2 {
        font-size: 32px;
    }

    .ticket h2 {
        font-size: 30px;
    }

    nav {
        padding: 15px 20px;
    }
}

@media(max-width:450px) {

    .discord-btn {
        padding: 8px 12px;
        font-size: 13px;
    }

    .hero h1 {
        font-size: 48px;
    }

    .hero p {
        font-size: 16px;
    }

    section {
        padding: 70px 15px;
    }
}
</style>
</head>

